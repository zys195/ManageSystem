# ===== 合同管理系统 - 环境变量配置 =====
# 复制此文件为 .env 并修改实际值

# 安全密钥（生产环境必须修改！）
SECRET_KEY=your_random_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# 数据库连接（Docker部署使用PostgreSQL）
SQLALCHEMY_DATABASE_URI=postgresql://contract_user:change_me_in_production@db:5432/contract_system

# 跨域配置（修改为实际前端域名）
CORS_ORIGINS=http://your-domain.com,http://localhost:5173

# Flask 配置
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=7999

# 协作编辑配置
COLLAB_EDIT_LOCK_TIMEOUT=300          # 编辑锁超时（秒）
COLLAB_HEARTBEAT_INTERVAL=15         # 心跳间隔（秒）
COLLAB_MAX_ONLINE_USERS=100          # 最大同时在线人数

# 数据库密码（用于 docker-compose）
DB_PASSWORD=your_secure_db_password
